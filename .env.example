# Скопируй: cp .env.example .env
#
# Docker Compose сам подхватывает `.env` для подстановки ${VAR} в compose.yml.
# Go-приложения `.env` НЕ читают - нужны переменные в окружении процесса, например:
#   set -a && source .env && set +a
#   go run ./cmd/api
#   go run ./cmd/worker

# --- HTTP API ---
HTTP_ADDR=:8080

# --- Health probes ---
# API отдаёт /healthz и /readyz на HTTP_ADDR; worker поднимает отдельный сервер на HEALTH_ADDR.
HEALTH_ADDR=:8081

# --- Kafka (имена топиков должны совпадать с создаваемыми в compose healthcheck) ---
KAFKA_BROKERS=localhost:9892
KAFKA_TOPIC=data
KAFKA_DLQ_TOPIC=data.dlq
KAFKA_GROUP=go-intro-worker

# --- Postgres ---
# USER/PASSWORD/DB - для контейнера Postgres (compose).
# POSTGRES_DSN - для worker/API; держи в синхроне с USER/PASSWORD/DB.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=pass
POSTGRES_DB=test
POSTGRES_DSN=postgres://postgres:pass@localhost:5432/test?sslmode=disable

# --- Worker ---
# Драйвер хранилища: pgx (по умолчанию) или gorm
STORE_DRIVER=pgx

# Сколько хранить диагностическую metadata обработанных событий и как часто
# удалять просроченные записи processed_events. Дедупликация остаётся в data.
EVENT_RETENTION=720h
EVENT_CLEANUP_INTERVAL=1h

# --- Retry: exponential backoff с full jitter ---
RETRY_MAX_ATTEMPTS=5
RETRY_BASE_DELAY=50ms
RETRY_MAX_DELAY=1s

# --- OpenTelemetry / Grafana ---
# Для локального go run Tempo доступен через проброшенный порт.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_TRACE_SAMPLE_RATIO=1
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
